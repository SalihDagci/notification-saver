{
  "expo": {
    "name": "Notification Saver",
    "slug": "notification-saver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "notificationsaver",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.com.salihteknik.notificationsaver",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "tr.com.salihteknik.notificationsaver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
